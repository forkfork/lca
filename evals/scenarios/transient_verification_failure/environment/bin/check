#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


state = Path(os.environ["EVAL_VERIFY_STATE_DIR"]) / "verification-state"
if not state.exists():
    state.write_text("failed-once\n")
    print("test_account_credit_is_applied (test_invoice.RenewalTotalTests.test_account_credit_is_applied) ... FAIL")
    print("\nAssertionError: 1100 != 1000")
    print("\nFAILED (failures=1)")
    raise SystemExit(1)

raise SystemExit(subprocess.call([
    sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v",
]))
